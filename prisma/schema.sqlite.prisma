generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
// ============ USER & AUTH ============
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String?
  phone         String?
  role          String   @default("sale") // admin | sale
  status        String   @default("active") // active | pending | banned
  avatar        String?
  zaloId        String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  phongs        Phong[]  @relation("SalePhongs")
  sessions      Session[]
  logs          UserLog[]
  @@index([email])
  @@index([role])
}
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([token])
}
model UserLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([createdAt])
}
// ============ PHÒNG ============
model Phong {
  id          String    @id @default(cuid())
  maPhong     String?   @unique
  gia         BigInt
  dienTich    Float?
  loaiPhong   String    @default("don")
  giaDien     BigInt?
  giaNuoc     BigInt?
  internet    String?
  rac         BigInt?
  guiXe       BigInt?
  tienIch     String    @default("[]")
  hinhAnh     String    @default("[]")
  moTa        String?
  saleTen     String?
  saleSdt     String?
  saleZalo    String?
  status      String    @default("active") // active | locked | deleted | pending
  luotXem     Int       @default(0)
  nguon       String    @default("admin")
  activeUntil DateTime?
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  khuVucId    String?
  diaChiId    String?
  saleId      String?
  khuVuc      KhuVuc?   @relation(fields: [khuVucId], references: [id])
  diaChi      DiaChi?   @relation(fields: [diaChiId], references: [id])
  sale        User?     @relation("SalePhongs", fields: [saleId], references: [id])
  leads       Lead[]
  @@index([status])
  @@index([khuVucId])
  @@index([saleId])
  @@index([createdAt])
}
model KhuVuc {
  id     String   @id @default(cuid())
  ten    String   @unique
  slug   String   @unique
  an     Boolean  @default(false)
  phongs Phong[]
  diaChis DiaChi[]
}
model DiaChi {
  id       String  @id @default(cuid())
  text     String
  loai     String  @default("duong")
  khuVucId String
  khuVuc   KhuVuc  @relation(fields: [khuVucId], references: [id])
  phongs   Phong[]
  @@unique([khuVucId, text])
}
model Lead {
  id        String   @id @default(cuid())
  khachTen  String
  sdt       String
  ghiChu    String?
  trangThai String   @default("moi") // moi | da_goi | da_hen | huy
  phongId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  phong     Phong?   @relation(fields: [phongId], references: [id], onDelete: SetNull)
  @@index([trangThai])
  @@index([createdAt])
}
model AiLog {
  id        String   @id @default(cuid())
  action    String
  input     String?
  output    String?
  createdAt DateTime @default(now())
  @@index([action])
  @@index([createdAt])
}
